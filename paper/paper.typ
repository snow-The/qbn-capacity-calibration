  columns: (auto, 1fr, auto),
  table.header([*電路*], [*比對*], [*max $abs(Delta P)$*]),
  [複現管線], [CUDA-Q vs 純 NumPy 參考], [$4.16 times 10^(-17)$],
  [容量掃描最大電路（250 閘）], [CUDA-Q vs torch 可微分模擬器], [$3.47 times 10^(-18)$],
  [消融電路（5 qubit）], [CUDA-Q vs 密度矩陣模擬器], [$8.33 times 10^(-17)$],
